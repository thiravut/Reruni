# TiktokRerun — env var template
# Copy to .env and fill values. .env must be in .gitignore.

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8090

PORT_ADDR=:8080
DB_PATH=./rerun.db
UPLOAD_DIR=./uploads
SESSION_TTL_HOURS=720
SECURE_COOKIES=false

# Stripe — obtain from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Stripe Price IDs — create products in Dashboard at 1990/4990/14900 THB
# then paste Price IDs (price_xxx). Empty values hide that tier from
# /api/billing/tiers.
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_GROWTH=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_PRO=price_XXXXXXXXXXXXXXXX

# Stripe redirects after Checkout — must match the SPA host:port
PORTAL_SUCCESS_URL=http://localhost:5173/billing/success
PORTAL_CANCEL_URL=http://localhost:5173/billing/cancel
