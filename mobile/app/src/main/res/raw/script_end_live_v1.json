{
  "name": "end_live",
  "version": 1,
  "min_tiktok_version": "45.0.0",
  "description": "Bring TikTok forward + tap End live + dismiss confirm dialog. Driven from server-side `end_live` command or operator UI.",
  "steps": [
    {"op": "step", "label": "จบไลฟ์: นำ TikTok ขึ้นมา (รักษา task เดิม)"},
    {"op": "launch_tiktok", "preserve_task": true},
    {"op": "delay", "ms": 1500},

    {"op": "step", "label": "ปิด modal บล็อก UI ถ้ามี (Gifting suspended, ฯลฯ)"},
    {"op": "tap_by_text",
     "labels": ["OK", "ตกลง", "Got it", "เข้าใจแล้ว", "Continue", "ดำเนินการต่อ", "Dismiss", "ปิด", "Close", "I understand"],
     "retries": 2,
     "allow_content_desc": true,
     "ignore_failure": true,
     "warn_on_fail": "no blocking modal — proceeding"},
    {"op": "delay", "ms": 600},

    {"op": "step", "label": "press BACK ปิด bottom sheet / sub-page (profile sheet, ฯลฯ)"},
    {"op": "press_back", "count": 2, "interval_ms": 500},
    {"op": "delay", "ms": 800},

    {"op": "step", "label": "กดปุ่มชัดดาวน์มุมขวาบน (End live icon)"},
    {"op": "tap_by_text",
     "labels": ["Close", "End", "End live", "End LIVE", "End broadcast", "Stop", "Stop live", "Stop LIVE", "Stop broadcast", "Power off", "Shutdown", "ปิด", "ปิดไลฟ์", "จบไลฟ์", "ปิด LIVE", "สิ้นสุดไลฟ์", "หยุดไลฟ์", "หยุด"],
     "retries": 8,
     "allow_content_desc": true,
     "verify_disappear": true,
     "bounds": {"min_x_pct": 70, "min_y_pct": 0, "max_x_pct": 100, "max_y_pct": 18},
     "fail": "ไม่พบปุ่ม End live ที่มุมขวาบน — ดู dump"},
    {"op": "delay", "ms": 1200},

    {"op": "step", "label": "ยืนยัน End"},
    {"op": "tap_by_text",
     "labels": ["End", "End LIVE", "End broadcast", "Confirm", "ยืนยัน", "ปิดไลฟ์", "ใช่", "Yes", "OK", "ตกลง"],
     "retries": 4,
     "allow_content_desc": true,
     "ignore_failure": true,
     "warn_on_fail": "no End confirm dialog — some TikTok variants skip it"},
    {"op": "delay", "ms": 1500},

    {"op": "step", "label": "✓ Live จบแล้ว"}
  ]
}
