{
  "name": "shoppable_vcam",
  "version": 1,
  "min_tiktok_version": "45.0.0",
  "description": "V3/V2 Shoppable Live — + → LIVE → Device camera → business icon → product manager → product picker → search + auto-pin → Done × N → Go LIVE. VCam (Magisk GhostCam / Reruni vcam module) supplies the prerecorded video to camera2 so TikTok captures it as the live stream.",
  "steps": [
    {"op": "step", "label": "เปิด TikTok…"},
    {"op": "launch_tiktok"},
    {"op": "delay", "ms": 3000},

    {"op": "step", "label": "กลับไปหน้าหลัก TikTok…"},
    {"op": "ensure_home"},
    {"op": "delay", "ms": 500},

    {"op": "step", "label": "กด + (Create)"},
    {"op": "tap_by_text",
     "labels": ["สร้าง", "Create", "post", "โพสต์"],
     "retries": 8,
     "allow_content_desc": true,
     "fail": "ไม่พบปุ่ม +"},
    {"op": "delay", "ms": 2500},

    {"op": "step", "label": "กด LIVE"},
    {"op": "tap_by_text",
     "labels": ["LIVE", "ไลฟ์", "Live", "ถ่ายทอดสด"],
     "retries": 8,
     "allow_content_desc": true,
     "fail": "ไม่พบ LIVE"},
    {"op": "delay", "ms": 1800},

    {"op": "step", "label": "ไปยัง Device camera (swipe tab strip + tap)"},
    {"op": "swipe_to_find_tab",
     "tab_label": "Device camera",
     "confirm_markers": ["Beautify", "Effects", "Flip", "Interact", "ปรับแต่ง", "เอฟเฟกต์"],
     "swipe_x1": 150, "swipe_x2": 950, "swipe_y": 1965, "swipe_duration_ms": 350,
     "max_iterations": 6,
     "settle_delay_ms": 1800,
     "between_swipe_delay_ms": 700,
     "ignore_failure": true},

    {"op": "step", "label": "⏳ สลับไป Device camera ด้วยมือ (รอ 20s ถ้าจำเป็น)"},
    {"op": "wait_for_any",
     "labels": ["Beautify", "Effects", "Flip", "Interact", "ปรับแต่ง", "เอฟเฟกต์"],
     "timeout_ms": 20000,
     "interval_ms": 600,
     "fail": "ไม่พบ Device camera mode (Details icon ไม่ปรากฏ) — ดู dump"},
    {"op": "delay", "ms": 800},

    {"op": "step", "label": "📝 ตั้ง live title (ถ้ามี)"},
    {"op": "set_live_title_if_provided"},
    {"op": "delay", "ms": 800},

    {"op": "step", "label": "กด business icon (Details)"},
    {"op": "tap_by_text",
     "labels": ["Business", "ธุรกิจ"],
     "retries": 8,
     "allow_content_desc": true,
     "fail": "ไม่พบ business icon (Details) — ดู dump"},

    {"op": "step", "label": "รอ commerce sheet เปิด (Layer 2)…"},
    {"op": "wait_for_any",
     "labels": ["Add products", "Add Product", "เพิ่มสินค้า", "Manage products", "จัดการสินค้า"],
     "timeout_ms": 8000,
     "interval_ms": 300,
     "fail": "commerce sheet (Layer 2) ไม่เปิด — กด Business แล้วไม่เห็น 'Add products' — ดู dump"},
    {"op": "delay", "ms": 3500},

    {"op": "step", "label": "กด 'Add products' (Layer 2 → 3)"},
    {"op": "tap_by_text",
     "labels": ["Add products", "Add Product", "เพิ่มสินค้า", "Manage products", "จัดการสินค้า"],
     "retries": 4,
     "allow_content_desc": true,
     "fail": "Layer 2: ไม่พบ 'Add products' — ดู dump"},

    {"op": "step", "label": "รอ product manager render (Layer 3)…"},
    {"op": "delay", "ms": 5000},

    {"op": "step", "label": "🧹 ลบ product ที่ค้างอยู่ (ถ้ามี)"},
    {"op": "remove_pre_selected_products"},
    {"op": "delay", "ms": 1200},

    {"op": "step", "label": "กด 'Add products' (Layer 3 → 4)"},
    {"op": "tap_by_text",
     "labels": ["Add products", "Add Product", "เพิ่มสินค้า", "Manage products", "จัดการสินค้า"],
     "retries": 4,
     "allow_content_desc": true,
     "fail": "Layer 3: ไม่พบ 'Add products' — ดู dump"},

    {"op": "step", "label": "รอ product picker เปิด (Layer 4)…"},
    {"op": "delay", "ms": 5000},

    {"op": "step", "label": "🔍 ค้นหา product"},
    {"op": "search_in_picker_first_keyword"},

    {"op": "step", "label": "🛍 auto-pin product(s)"},
    {"op": "auto_pin_products",
     "fail_if_zero": "auto-pin: ไม่พบ product ใดตรง keyword — เช็ค Settings + ดู dump"},
    {"op": "delay", "ms": 1500},

    {"op": "step", "label": "กด Done (Layer 4 → 3)"},
    {"op": "tap_by_text",
     "labels": ["Done", "เสร็จสิ้น", "เสร็จ", "ตกลง", "OK"],
     "retries": 4,
     "allow_content_desc": true,
     "fail": "ไม่พบ Done ปิด picker"},
    {"op": "delay", "ms": 2000},

    {"op": "step", "label": "กด Done (Layer 3 → 2)"},
    {"op": "tap_by_text",
     "labels": ["Done", "เสร็จสิ้น", "เสร็จ", "ตกลง", "OK"],
     "retries": 4,
     "allow_content_desc": true,
     "ignore_failure": true,
     "warn_on_fail": "no Done at Layer 3 — may have auto-collapsed"},
    {"op": "delay", "ms": 1500},

    {"op": "tap_by_text",
     "labels": ["Done", "เสร็จสิ้น", "เสร็จ", "ตกลง", "OK"],
     "retries": 2,
     "allow_content_desc": true,
     "ignore_failure": true},
    {"op": "delay", "ms": 1500},

    {"op": "wait_for_any",
     "labels": ["Beautify", "Effects", "Flip", "Interact", "ปรับแต่ง", "เอฟเฟกต์"],
     "timeout_ms": 10000,
     "fail": "auto-pin หลัง Done ไม่กลับมาที่ Device camera — ดู dump"},
    {"op": "delay", "ms": 500},

    {"op": "step", "label": "กด Go LIVE (Device camera)"},
    {"op": "tap_by_text",
     "labels": ["Go LIVE", "Go Live", "GO LIVE", "เริ่มไลฟ์", "เริ่ม LIVE", "เริ่ม Live", "ไลฟ์ทันที", "ไปสด", "Start"],
     "retries": 8,
     "allow_content_desc": true,
     "fail": "ไม่พบ Go LIVE (Device camera)"},
    {"op": "delay", "ms": 2000},

    {"op": "tap_by_text",
     "labels": ["Start now", "เริ่มเลย", "Start", "เริ่ม", "ตกลง", "OK"],
     "retries": 2,
     "ignore_failure": true},
    {"op": "delay", "ms": 1500},

    {"op": "step", "label": "✓ Shoppable Live พร้อม (VCam feeding camera)"}
  ]
}
