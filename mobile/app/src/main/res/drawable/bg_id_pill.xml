<?xml version="1.0" encoding="utf-8"?>
<!-- Device ID pill at the bottom of the device card — thin accent stroke,
     bg pulled slightly darker than the card so it nests visibly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#22000000" />
    <stroke
        android:width="1dp"
        android:color="@color/reruni_accent_stroke" />
    <corners android:radius="14dp" />
</shape>
