<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square frame behind the person/phone icons inside the identity
     + device cards. Soft cyan wash + thin stroke so the icon sits in a
     "module slot" rather than floating. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/reruni_accent_wash" />
    <stroke
        android:width="1dp"
        android:color="@color/reruni_accent_stroke" />
    <corners android:radius="14dp" />
</shape>
