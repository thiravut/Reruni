<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Forced dark theme matching reruni.com landing palette. We don't
         inherit DayNight because the landing is dark-only — branching into
         a light variant just for the app would diverge the two surfaces. -->
    <style name="Theme.TiktokRerun" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/reruni_accent</item>
        <item name="colorOnPrimary">@color/reruni_accent_fg</item>
        <item name="colorPrimaryContainer">#33FB7185</item>
        <item name="colorOnPrimaryContainer">@color/reruni_fg</item>
        <item name="colorSecondary">@color/reruni_accent</item>
        <item name="colorOnSecondary">@color/reruni_accent_fg</item>
        <item name="colorError">@color/reruni_danger</item>
        <item name="colorOnError">@color/reruni_fg</item>
        <item name="android:colorBackground">@color/reruni_bg</item>
        <item name="colorSurface">@color/reruni_bg</item>
        <item name="colorSurfaceVariant">@color/reruni_surface_subtle</item>
        <item name="colorOnSurface">@color/reruni_fg</item>
        <item name="colorOnSurfaceVariant">@color/reruni_muted</item>
        <item name="colorOutline">@color/reruni_border</item>
        <item name="colorOutlineVariant">@color/reruni_border</item>
        <item name="android:statusBarColor">@color/reruni_bg</item>
        <item name="android:navigationBarColor">@color/reruni_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.TiktokRerun.Fullscreen" parent="Theme.TiktokRerun">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Reusable text styles -->
    <style name="TextAppearance.TR.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.TR.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.TR.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.TR.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.TR.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Widget.TR.Card.Subtle">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.TR.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.TR.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.TR.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.TR.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
