<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand -->
    <color name="brand_primary">#FF00C4B4</color>
    <color name="brand_primary_dark">#FF008577</color>
    <color name="brand_accent">#FFFF2D55</color>

    <!-- Surfaces (light) -->
    <color name="bg_light">#FFF5F7FA</color>
    <color name="surface_light">#FFFFFFFF</color>
    <color name="surface_variant_light">#FFEEF2F6</color>
    <color name="on_surface_light">#FF0E1419</color>
    <color name="on_surface_muted_light">#FF5F6B76</color>

    <!-- Surfaces (dark) -->
    <color name="bg_dark">#FF0B0F12</color>
    <color name="surface_dark">#FF161B20</color>
    <color name="surface_variant_dark">#FF1F262D</color>
    <color name="on_surface_dark">#FFF5F7FA</color>
    <color name="on_surface_muted_dark">#FF9AA5B1</color>

    <!-- Status -->
    <color name="status_online">#FF22C55E</color>
    <color name="status_offline">#FF94A3B8</color>
    <color name="status_error">#FFEF4444</color>
    <color name="status_warn">#FFF59E0B</color>

    <!-- Reruni in-app palette. Diverges from the legacy landing CSS
         (rose pink) — the Gemini reference design uses a cyan/mint accent
         with neon outlines, which is what ships in the app today. Landing
         can adopt the same palette in a follow-up. Always dark. -->
    <color name="reruni_bg">#FF0A0F14</color>
    <color name="reruni_fg">#FFF4F4F5</color>
    <color name="reruni_muted">#FF94A3B8</color>
    <!-- Brand accent (play triangle, card outlines, status pill border). -->
    <color name="reruni_accent">#FF5EEAD4</color>
    <color name="reruni_accent_fg">#FF0A0F14</color>
    <!-- Soft 20% accent for inner halos. -->
    <color name="reruni_accent_glow">#335EEAD4</color>
    <!-- 45% accent — what card / pill strokes use so they actually read as
         cyan outlines on a dark surface; 20% disappears in daylight. -->
    <color name="reruni_accent_stroke">#735EEAD4</color>
    <!-- Even softer (8%) accent tint behind cards for the neon feel. -->
    <color name="reruni_accent_wash">#145EEAD4</color>
    <color name="reruni_border">#FF1E293B</color>
    <!-- Subtle card surface — slightly elevated above bg, behind accent stroke. -->
    <color name="reruni_surface_subtle">#1A1B2E</color>
    <color name="reruni_danger">#FFEF4444</color>
    <!-- Environment chip ("Reruni Ecosystem (ทดสอบ)") — different accent so
         the operator doesn't confuse it with the connection state. -->
    <color name="reruni_env_dot">#FFA855F7</color>
</resources>
