<?xml version="1.0" encoding="utf-8"?>
<!-- Post-pair home screen, Gemini reference design.
     Layout: brand row → status pill → identity card (account) → device card
     → env chip → red destructive Disconnect (bottom-pinned). The two
     identity cards use the neon-outline drawable to match the landing-cyan
     direction; the env chip and ID pill share that stroke for cohesion. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reruni_bg"
    android:fitsSystemWindows="true">

    <!-- ── Brand row ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/brandRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_brand_play" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/reruni_fg"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Scroll body ───────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/disconnectButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Status pill (connection state + server URL) ───────────── -->
            <LinearLayout
                android:id="@+id/statusPillContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_link" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusPillTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/status_pill_disconnected"
                        android:textColor="@color/reruni_fg"
                        android:textSize="14sp"
                        tools:text="สถานะ: เชื่อมต่อสำเร็จ" />

                    <TextView
                        android:id="@+id/statusPillSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/reruni_muted"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="กับ api.reruni.com"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Identity card (account) ──────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_glow"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/identity_section"
                    android:textColor="@color/reruni_fg"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_identity_icon"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person_filled"
                            app:tint="@color/reruni_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/identityOwnerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/identity_owner_unknown"
                            android:textColor="@color/reruni_fg"
                            android:textSize="16sp"
                            tools:text="pond@example.com" />

                        <TextView
                            android:id="@+id/identityAccountType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/reruni_muted"
                            android:textSize="12sp"
                            tools:text="ประเภท: บัญชีผู้ใช้" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Device card ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_glow"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/identity_device_section"
                    android:textColor="@color/reruni_fg"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_identity_icon"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone_outline"
                            app:tint="@color/reruni_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/identityDeviceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/reruni_fg"
                            android:textSize="16sp"
                            tools:text="SM-A156E" />

                        <TextView
                            android:id="@+id/identityDeviceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/reruni_muted"
                            android:textSize="12sp"
                            tools:text="ชื่อ: Galaxy A15 5G" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Device ID pill -->
                <TextView
                    android:id="@+id/identityDeviceIdText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_id_pill"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/reruni_muted"
                    android:textSize="12sp"
                    tools:text="ไอดีอุปกรณ์ (Device ID):\ndev-2f7821e6e6fa" />
            </LinearLayout>

            <!-- ── Permissions card (only when something missing) ────────── -->
            <LinearLayout
                android:id="@+id/permissionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_glow"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/permissions_section"
                    android:textColor="@color/reruni_fg"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/permAccessibilityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/permission_accessibility_title"
                            android:textColor="@color/reruni_fg"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/permAccessibilityStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/permission_accessibility_desc"
                            android:textColor="@color/reruni_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permAccessibilityButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/permission_action_enable"
                        android:textColor="@color/reruni_accent"
                        android:textSize="13sp"
                        app:rippleColor="@color/reruni_accent_glow"
                        app:strokeColor="@color/reruni_accent_glow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/permNotificationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/permission_notification_title"
                            android:textColor="@color/reruni_fg"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/permNotificationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/permission_notification_desc"
                            android:textColor="@color/reruni_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permNotificationButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/permission_action_enable"
                        android:textColor="@color/reruni_accent"
                        android:textSize="13sp"
                        app:rippleColor="@color/reruni_accent_glow"
                        app:strokeColor="@color/reruni_accent_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Ecosystem env chip ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_env_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/ecosystem_label"
                    android:textColor="@color/reruni_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom destructive: trash icon + red full-width ───────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/disconnectButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="22dp"
        android:backgroundTint="@color/reruni_danger"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/conn_disconnect_unpair"
        android:textColor="@color/reruni_fg"
        android:textSize="15sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_trash"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/reruni_fg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
