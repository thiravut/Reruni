<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen (post-pair). Logo + connection status, identity + permission
     panel, with a full-width red Disconnect button pinned to the bottom.
     Tapping Disconnect unpairs and returns to OnboardingActivity. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reruni_bg"
    android:fitsSystemWindows="true">

    <!-- Top brand row -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.02"
        android:text="Rerun-i"
        android:textColor="@color/reruni_fg"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openSettingsButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/open_settings"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@android:drawable/ic_menu_preferences"
        app:iconSize="22dp"
        app:iconTint="@color/reruni_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable body fills the gap between brand row and bottom button -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/disconnectButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Connection status chip -->
            <FrameLayout
                android:id="@+id/connectionChipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip_offline"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/connectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/conn_disconnected"
                    android:textColor="@color/reruni_fg"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- ── Identity card ───────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/reruni_surface_subtle"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="20dp"
                app:strokeColor="@color/reruni_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/identity_section"
                        android:textAllCaps="true"
                        android:textColor="@color/reruni_muted"
                        android:textSize="11sp" />

                    <!-- User row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_section_icon"
                            android:importantForAccessibility="no">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="👤"
                                android:textSize="17sp"
                                tools:ignore="HardcodedText" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_owner_label"
                                android:textColor="@color/reruni_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/identityOwnerText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/identity_owner_unknown"
                                android:textColor="@color/reruni_fg"
                                android:textSize="15sp"
                                tools:text="pond@example.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Device row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_section_icon"
                            android:importantForAccessibility="no">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="📱"
                                android:textSize="17sp"
                                tools:ignore="HardcodedText" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_device_label"
                                android:textColor="@color/reruni_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/identityDeviceText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/reruni_fg"
                                android:textSize="15sp"
                                tools:text="SM-A156E" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/identityDeviceIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/reruni_muted"
                        android:textSize="11sp"
                        tools:text="ID: 6d8dc3d9d4e2ba9c" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Permissions card ─────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/permissionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/reruni_surface_subtle"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="20dp"
                app:strokeColor="@color/reruni_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/permissions_section"
                        android:textAllCaps="true"
                        android:textColor="@color/reruni_muted"
                        android:textSize="11sp" />

                    <!-- Accessibility row -->
                    <LinearLayout
                        android:id="@+id/permAccessibilityRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/permission_accessibility_title"
                                android:textColor="@color/reruni_fg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/permAccessibilityStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/permission_accessibility_desc"
                                android:textColor="@color/reruni_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/permAccessibilityButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="44dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="@string/permission_action_enable"
                            android:textColor="@color/reruni_accent"
                            android:textSize="13sp"
                            app:rippleColor="@color/reruni_border"
                            app:strokeColor="@color/reruni_border" />
                    </LinearLayout>

                    <!-- Notification row (Android 13+) -->
                    <LinearLayout
                        android:id="@+id/permNotificationRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/permission_notification_title"
                                android:textColor="@color/reruni_fg"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/permNotificationStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/permission_notification_desc"
                                android:textColor="@color/reruni_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/permNotificationButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="44dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="@string/permission_action_enable"
                            android:textColor="@color/reruni_accent"
                            android:textSize="13sp"
                            app:rippleColor="@color/reruni_border"
                            app:strokeColor="@color/reruni_border" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom action stack ────────────────────────────────────────────── -->
    <!-- The red Disconnect is destructive (wipes creds, requires re-pair).
         Most operators just want to pause WS traffic; the pause toggle above
         keeps the device record + creds and survives restarts via
         AppPrefs.connectionPaused. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/connectionToggleButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/conn_pause"
        android:textColor="@color/reruni_fg"
        android:textSize="14sp"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/disconnectButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/reruni_border"
        app:strokeColor="@color/reruni_border" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/disconnectButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/reruni_danger"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/conn_disconnect_unpair"
        android:textColor="@color/reruni_fg"
        android:textSize="15sp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
