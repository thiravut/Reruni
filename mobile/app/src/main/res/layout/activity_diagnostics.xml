<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/diagnosticsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/nav_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/diagnostics_screen_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_subtitle"
                android:textAppearance="@style/TextAppearance.TR.Caption" />

            <!-- Local playlist (dry-run video supply) ─── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diag_playlist_label"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diag_playlist_help"
                                android:textAppearance="@style/TextAppearance.TR.Caption" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearButton"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/clear_list"
                            android:enabled="false"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:icon="@android:drawable/ic_menu_delete"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/selectedVideoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:maxLines="8"
                        android:text="@string/no_video_selected"
                        android:textAppearance="@style/TextAppearance.TR.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickVideoButton"
                        style="@style/Widget.TR.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/pick_video" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startButton"
                        style="@style/Widget.TR.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:enabled="false"
                        android:text="@string/start_broadcast" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Workflow hint ────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TR.Card.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_quick_start"
                        android:textAppearance="@style/TextAppearance.TR.SectionLabel" />

                    <TextView
                        android:id="@+id/hintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/hint_workflow"
                        android:textAppearance="@style/TextAppearance.TR.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UI dump (debug builds only — visibility toggled in code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dumpUiButton"
                style="@style/Widget.TR.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/debug_dump_ui"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
