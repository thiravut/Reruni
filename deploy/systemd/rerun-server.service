[Unit]
Description=Rerun API server (Go)
After=network-online.target postgresql-17.service
Wants=network-online.target

[Service]
Type=simple
User=reruni
Group=reruni
WorkingDirectory=/home/reruni
EnvironmentFile=/etc/rerun/env
ExecStart=/home/reruni/rerun-bin/server -addr=127.0.0.1:18080 -uploads=/home/reruni/rerun-data/uploads -downloads=/home/reruni/rerun-data/downloads
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/reruni/rerun-data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
